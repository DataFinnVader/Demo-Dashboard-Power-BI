	partition Calender_Auto = calculated
		mode: import
		source =
				VAR StartDatum = DATE(2023, 1, 1)
				VAR EndDatum = DATE(2026, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(StartDatum, EndDatum),
				    "Jahr", YEAR([Date]),
				    "Monatsname", FORMAT([Date], "MMMM"),
				    "Monatsnummer", MONTH([Date]),
				    "Jahr_Monat", FORMAT([Date], "YYYY-MM"),
				    "Woche", WEEKNUM([Date],1)
				)

	annotation PBI_Id = f2449c32daab4d2bb3821a1cc73bfa77

